# Moodle MCP Server

# Required: URL of your Moodle instance (no trailing slash)
MOODLE_URL=https://your-moodle-instance.com

# Required: Moodle Web Services API token
# Obtain: Site administration > Plugins > Web services > Manage tokens
MOODLE_TOKEN=your-moodle-api-token-here

# Optional: API key for HTTP transport mode (generate with: openssl rand -hex 32)
# MOODLE_API_KEY=

# Optional: Premium plugin license key (format: moodle-lic-<32 hex chars>)
# MOODLE_PLUGIN_KEY=

# Optional: Override config.json settings
# MOODLE_API_VERSION=auto
# LOGGING_LEVEL=info
