{
  "name": "moodle-mcp-server-aql",
  "version": "0.1.2",
  "mcpName": "io.github.csmediapro/moodle-mcp-server-aql",
  "description": "Open-source MCP server for querying Moodle LMS data through natural language. Attach your agent to your LMS data.",
  "license": "AGPL-3.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "homepage": "https://csmediapro.com/products/moodle-mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csmediapro/moodle-mcp-server.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/csmediapro/moodle-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "moodle",
    "lms",
    "education",
    "ai",
    "agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "moodle-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/index.*",
    "dist/auth/**/*",
    "dist/config/**/*",
    "dist/logging/**/*",
    "dist/moodle/**/*",
    "dist/plugins/contracts.*",
    "dist/plugins/loader.*",
    "dist/schema/**/*",
    "dist/server/**/*",
    "dist/tools/**/*",
    "dist/utils/**/*",
    "data/user-field-schema.example.json",
    "config.example.json",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^17.4.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
