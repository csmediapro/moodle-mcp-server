{
  "name": "@csmediapro/moodle-mcp-server",
  "version": "0.1.0",
  "description": "Open-source MCP server for querying Moodle LMS data through Moodle Web Services",
  "license": "AGPL-3.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "moodle-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/index.*",
    "dist/auth/**/*",
    "dist/config/**/*",
    "dist/logging/**/*",
    "dist/moodle/**/*",
    "dist/plugins/contracts.*",
    "dist/plugins/loader.*",
    "dist/schema/**/*",
    "dist/server/**/*",
    "dist/tools/**/*",
    "dist/utils/**/*",
    "data/user-field-schema.example.json",
    "config.example.json",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^17.4.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
