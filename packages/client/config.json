{
  "llm": {
    "active": "ollama-cloud",
    "providers": {
      "anthropic": {
        "type": "anthropic",
        "label": "Anthropic",
        "baseUrl": "https://api.anthropic.com",
        "defaultModel": "claude-sonnet-4-5-20250929",
        "apiKeyEnv": "ANTHROPIC_API_KEY",
        "contextWindow": 200000,
        "enabled": true
      },
      "openai": {
        "type": "openai-compatible",
        "label": "OpenAI",
        "baseUrl": "https://api.openai.com/v1",
        "defaultModel": "gpt-4o",
        "apiKeyEnv": "OPENAI_API_KEY",
        "contextWindow": 131072,
        "enabled": true
      },
      "ollama-cloud": {
        "type": "openai-compatible",
        "label": "Ollama Cloud",
        "baseUrl": "https://ollama.com/v1",
        "defaultModel": "gemma4:31b",
        "apiKeyEnv": "OLLAMA_API_KEY",
        "contextWindow": 131072,
        "enabled": true
      },
      "local-llamacpp": {
        "type": "openai-compatible",
        "label": "llama.cpp (local)",
        "baseUrl": "http://blaster:8080/v1",
        "defaultModel": "auto",
        "contextWindow": 59904,
        "modelContextWindows": {
          "mistralai_Devstral-Small-2-24B-Instruct-2512-Q4_K_M.gguf": 59904,
          "qwen35-codeforces-27b-rl-step25-Q4_K_M.gguf": 32768
        },
        "enabled": true
      }
    }
  },
  "mcp": {
    "serverCommand": "node",
    "serverArgs": ["dist/index.js"],
    "serverCwd": "../server"
  }
}
